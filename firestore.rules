rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Contact messages: allow public writes, but only authenticated users can read
    match /contact_messages/{messageId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'message', 'createdAt', 'status'])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.message is string
        && request.resource.data.name.size() > 0
        && request.resource.data.email.size() > 0
        && request.resource.data.message.size() >= 10
        && (!('subject' in request.resource.data) || request.resource.data.subject is string);
      allow read: if request.auth != null;
    }
    
    // users/{userId}/extraccion_datos_batches: only owner can read/write
    match /users/{userId}/extraccion_datos_batches/{batchId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // users/{userId}/extraccion_datos_results: only owner can read/write
    match /users/{userId}/extraccion_datos_results/{fileId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // uploaded_files: users can read/write their own (userId field)
    match /uploaded_files/{fileId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // users/{userId}: owner can read their full profile.
    // For writes: owner can update profile fields, but credit/Stripe fields are
    // Admin-SDK-only (mutated by the Stripe webhook and /api/creditos/consumir).
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['creditos_disponibles', 'creditos_consumidos', 'stripe_customer_id']);
    }

    // users/{userId}/creditos_log: owner can read for balance history display.
    // All writes are Admin-SDK-only (stripeWebhook + /api/creditos/consumir).
    match /users/{userId}/creditos_log/{logId} {
      allow read: if request.auth != null && request.auth.uid == userId;
    }

    // users/{userId}/reclamaciones_cantidades: owner can read; writes are Admin-SDK-only
    // (created by /api/reclamacion-cantidades server route before Stripe checkout).
    match /users/{userId}/reclamaciones_cantidades/{caseId} {
      allow read: if request.auth != null && request.auth.uid == userId;
    }

    // cases: owned by the userId field
    match /cases/{caseId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // clients: owned by the userId field
    match /clients/{clientId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // conversations: owned by the userId field
    match /conversations/{conversationId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // documents: owned by the userId field
    match /documents/{docId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // purchases: created and updated server-side by the Stripe webhook (Admin SDK,
    // bypasses these rules). Clients may only read their own purchase records.
    match /purchases/{purchaseId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // payment_metadata: client creates a record before checkout so the Stripe webhook
    // (Admin SDK) can associate the payment with this user. No client reads/updates.
    match /payment_metadata/{metadataId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Everything else is denied by default. Server-side code (Cloud Functions) uses
    // the Admin SDK and is not subject to these rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}




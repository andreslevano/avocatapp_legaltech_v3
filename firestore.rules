rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Contact messages: allow public writes, but only authenticated users can read
    match /contact_messages/{messageId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'message', 'createdAt', 'status'])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.message is string
        && request.resource.data.name.size() > 0
        && request.resource.data.email.size() > 0
        && request.resource.data.message.size() >= 10
        && (!('subject' in request.resource.data) || request.resource.data.subject is string);
      allow read: if request.auth != null;
    }
    
    // users/{userId}/extraccion_datos_batches: only owner can read/write
    match /users/{userId}/extraccion_datos_batches/{batchId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // users/{userId}/extraccion_datos_results: only owner can read/write
    match /users/{userId}/extraccion_datos_results/{fileId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // uploaded_files: users can read/write their own (userId field)
    match /uploaded_files/{fileId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // users/{userId}: owner can read their full profile.
    // For writes: owner can update profile fields, but credit/Stripe fields are
    // Admin-SDK-only (mutated by the Stripe webhook and /api/creditos/consumir).
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // `integrations` (connected-account display info, F1) is written only by server routes.
      allow create: if request.auth != null && request.auth.uid == userId
        && !('integrations' in request.resource.data);
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['creditos_disponibles', 'creditos_consumidos', 'stripe_customer_id', 'integrations']);
    }

    // users/{userId}/creditos_log: owner can read for balance history display.
    // All writes are Admin-SDK-only (stripeWebhook + /api/creditos/consumir).
    match /users/{userId}/creditos_log/{logId} {
      allow read: if request.auth != null && request.auth.uid == userId;
    }

    // users/{userId}/reclamaciones_cantidades: owner can read; writes are Admin-SDK-only
    // (created by /api/reclamacion-cantidades server route before Stripe checkout).
    match /users/{userId}/reclamaciones_cantidades/{caseId} {
      allow read: if request.auth != null && request.auth.uid == userId;
    }

    // cases: owned by the userId field
    match /cases/{caseId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // clients: owned by the userId field
    match /clients/{clientId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // conversations: owned by the userId field
    match /conversations/{conversationId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // documents: owned by the userId field. folderId (D1) is optional — missing/null = root;
    // when set it must point to a folder owned by the same user. userId cannot be reassigned.
    function ownsFolder(folderId) {
      return folderId is string
        && exists(/databases/$(database)/documents/folders/$(folderId))
        && get(/databases/$(database)/documents/folders/$(folderId)).data.userId == request.auth.uid;
    }

    // DocuSign (D11): signature state on documents is written by /api/signatures only.
    function signatureFields() {
      return ['signatureRequestId', 'signatureStatus', 'lockedAt', 'kind', 'signedFromDocumentId'];
    }

    match /documents/{docId} {
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid
        && !request.resource.data.keys().hasAny(signatureFields())
        && (!('folderId' in request.resource.data) || request.resource.data.folderId == null
            || ownsFolder(request.resource.data.folderId));
      allow update: if request.auth != null && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(signatureFields())
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['folderId'])
            || request.resource.data.folderId == null
            || ownsFolder(request.resource.data.folderId));
    }

    // folders (D1): user-managed tree, metadata only. Clients may create and rename;
    // moving (parentId/ancestors/depth) and deleting go through /api/folders/* (Admin SDK).
    function isValidFolderName(n) {
      return n is string && n.size() > 0 && n.size() <= 120 && n.trim() == n
        && n != '.' && n != '..'
        && !n.matches('.*[/\\\\:*?"<>|].*');
    }

    match /folders/{folderId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['userId', 'name', 'parentId', 'ancestors', 'depth', 'color', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['userId', 'name', 'parentId', 'ancestors', 'depth'])
        && isValidFolderName(request.resource.data.name)
        && request.resource.data.ancestors is list
        && request.resource.data.depth is int
        && (
          (request.resource.data.parentId == null
            && request.resource.data.ancestors.size() == 0
            && request.resource.data.depth == 1)
          || (request.resource.data.parentId is string
            && ownsFolder(request.resource.data.parentId)
            && request.resource.data.ancestors
                 == get(/databases/$(database)/documents/folders/$(request.resource.data.parentId)).data.ancestors
                      .concat([request.resource.data.parentId])
            && request.resource.data.depth
                 == get(/databases/$(database)/documents/folders/$(request.resource.data.parentId)).data.depth + 1
            && request.resource.data.depth <= 8)
        );

      allow update: if request.auth != null && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'color', 'updatedAt'])
        && isValidFolderName(request.resource.data.name);

      allow delete: if false;
    }

    // purchases: created and updated server-side by the Stripe webhook (Admin SDK,
    // bypasses these rules). Clients may only read their own purchase records.
    match /purchases/{purchaseId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // payment_metadata: client creates a record before checkout so the Stripe webhook
    // (Admin SDK) can associate the payment with this user. No client reads/updates.
    match /payment_metadata/{metadataId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // legal_chunks: public legal data (BOE + CENDOJ), readable by anyone.
    // Writes are Admin-SDK-only (ingestion script).
    match /legal_chunks/{chunkId} {
      allow read: if true;
    }

    // signature_requests/{id}: DocuSign envelopes (Phase 2). Owner reads; Admin SDK writes.
    match /signature_requests/{requestId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // integration_secrets/{uid}: encrypted OAuth tokens (Microsoft F1, DocuSign D4). Admin SDK only —
    // intentionally no client rule; covered by the catch-all deny below (tested).

    // Everything else is denied by default. Server-side code (Cloud Functions) uses
    // the Admin SDK and is not subject to these rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}




rules_version = '2';

// Firebase Cloud Storage Security Rules
// Hierarchy: {uid}/{userType}/{documentType}/documents|ocr/...
// User types: abogado | estudiante | autoservicio
// Document types follow sidebar menu (dashboard, casos, clientes, reclamacion-cantidades, etc.)

service firebase.storage {
  match /b/{bucket}/o {
    // NEW: UID-first hierarchy - {uid}/{userType}/{documentType}/...
    match /{userId}/{userType}/{documentType}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // LEGACY: Backward compatibility for existing files
    match /repositorio/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /students/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /reclamaciones/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /reclamaciones_cantidades/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Document branding logo (src/lib/branding.ts): owner only, raster images only (no SVG), ≤ 1 MB,
    // a single file named logo.<ext> whose extension matches its content type.
    match /users/{userId}/branding/{fileName} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 1024 * 1024
        && ((fileName == 'logo.png' && request.resource.contentType == 'image/png')
          || (fileName == 'logo.jpg' && request.resource.contentType == 'image/jpeg')
          || (fileName == 'logo.webp' && request.resource.contentType == 'image/webp'));
    }
    // Everything else under users/{uid}/ — branding/ is excluded so the rule above is the only grant.
    match /users/{userId}/{allPaths=**} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      // request.resource.name is the full object path (string): writes to branding/ are only
      // granted by the stricter rule above.
      allow create, update: if request.auth != null && request.auth.uid == userId
        && !request.resource.name.matches('users/[^/]+/branding/.*');
    }
    match /accion-tutela/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
